# Copy to data/.env (chmod 600) — or better, run `binanceclaw setup`, which writes it for you.
ADMIN_PASSWORD_HASH=          # argon2 hash, generated by `binanceclaw setup` / `binanceclaw password`
SESSION_SECRET=               # random hex, generated by setup
BINANCE_API_KEY=              # spot key: Reading + Spot trading ONLY, IP whitelist ON
BINANCE_API_SECRET=
TELEGRAM_BOT_TOKEN=           # optional, from @BotFather
TELEGRAM_CHAT_ID=             # optional, bound by setup
CLAUDE_CODE_OAUTH_TOKEN=      # optional, from `claude setup-token` (Claude subscription)
OPENAI_API_KEY=               # optional
OPENAI_COMPAT_API_KEY=        # optional (DeepSeek / Qwen / OpenRouter / Ollama ...)
ANTHROPIC_API_KEY=            # optional
